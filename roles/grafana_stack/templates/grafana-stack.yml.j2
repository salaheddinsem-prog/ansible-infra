version: "3.8"

services:
  grafana:
    image: "grafana/grafana:{{ grafana_version }}"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_DATABASE_TYPE: postgres
      GF_DATABASE_HOST: "{{ grafana_db_host }}:{{ grafana_db_port }}"
      GF_DATABASE_NAME: "{{ grafana_db_name }}"
      GF_DATABASE_USER: "{{ grafana_db_user }}"
      GF_DATABASE_PASSWORD__FILE: /run/secrets/grafana_db_password
      GF_DATABASE_SSL_MODE: disable
      GF_SERVER_PROTOCOL: https
      GF_SERVER_CERT_FILE: /run/secrets/grafana_tls_crt
      GF_SERVER_CERT_KEY: /run/secrets/grafana_tls_key
      GF_SERVER_ROOT_URL: "{{ grafana_root_url }}"
      GF_SMTP_ENABLED: "true"
      GF_SMTP_HOST: "{{ grafana_smtp_host }}"
      GF_SMTP_FROM_ADDRESS: "{{ grafana_smtp_from_address }}"
      GF_SMTP_FROM_NAME: "{{ grafana_smtp_from_name }}"
      GF_SMTP_EHLO_IDENTITY: "{{ grafana_smtp_ehlo_identity }}"
      GF_SMTP_STARTTLS_POLICY: MandatoryStartTLS
      GF_SMTP_SKIP_VERIFY: "false"
{% if grafana_plugins_preinstall | length > 0 %}
      GF_PLUGINS_PREINSTALL_SYNC: "{{ grafana_plugins_preinstall | join(',') }}"
{% endif %}
    secrets:
      - source: grafana_admin_password
        target: grafana_admin_password
      - source: grafana_db_password
        target: grafana_db_password
      - source: grafana_tls_crt
        target: grafana_tls_crt
        mode: 0444
      - source: grafana_tls_key
        target: grafana_tls_key
        uid: "472"
        gid: "0"
        mode: 0400
    volumes:
      - grafana_data:/var/lib/grafana
    ports:
      - target: 3000
        published: {{ grafana_https_port }}
        protocol: tcp
        mode: ingress
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == {{ grafana_node }}
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 1G

volumes:
  grafana_data:
    driver: local

secrets:
  grafana_admin_password:
    external: true
    name: "grafana_admin_password_v{{ grafana_secrets_version }}"
  grafana_db_password:
    external: true
    name: "grafana_db_password_v{{ grafana_secrets_version }}"
  grafana_tls_crt:
    external: true
    name: "{{ grafana_tls_cert_secret }}"
  grafana_tls_key:
    external: true
    name: "{{ grafana_tls_key_secret }}"
